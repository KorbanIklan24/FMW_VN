mouse_filter = 2
theme_override_colors/font_color = Color(0.760784, 0.796078, 0.878431, 1)
theme_override_font_sizes/font_size = 24
text = "Writing speeds multiply every line's own text_speed, so a line set to print at once still does. Auto-forward holds a finished line for the chosen time per drawn character, plus the {w=...} pauses it uses. Master volume scales the story's own music and sound levels; 0% is silence, 100% leaves them exactly as written."
horizontal_alignment = 1
autowrap_mode = 3

